# ─────────────────────────────────────────────────────────────────────
# MERCADUCA — Environment Variables Template
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── Database ──────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=root
DB_USERNAME=mercaduca
DB_PASSWORD=mercaduca_secure_pass
DB_URL=jdbc:mysql://localhost:3306/mercaduca?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# ── JPA ───────────────────────────────────────────────────────────────
# Options: create | create-drop | update | validate | none
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ── JWT ───────────────────────────────────────────────────────────────
# CHANGE THIS IN PRODUCTION: generate with `openssl rand -hex 32`
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000          # 24 hours in ms
JWT_REFRESH_EXPIRATION=604800000 # 7 days in ms

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# ── Mail ──────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@mercaduca.com
MAIL_PASSWORD=your_app_password

# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── PayPal ────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ── DHL ───────────────────────────────────────────────────────────────
DHL_API_KEY=
DHL_BASE_URL=https://api-mock.dhl.com/mydhlapi

# ── Correos ───────────────────────────────────────────────────────────
CORREOS_API_KEY=

# ── Uber Direct ───────────────────────────────────────────────────────
UBERDIRECT_CLIENT_ID=
UBERDIRECT_CLIENT_SECRET=
