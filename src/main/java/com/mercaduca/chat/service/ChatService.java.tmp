package com.mercaduca.chat.service;

import com.mercaduca.chat.dto.ChatDTOs;
import com.mercaduca.chat.entity.ChatMessage;
import com.mercaduca.chat.repository.ChatMessageRepository;
import com.mercaduca.common.dto.PageResponse;
import com.mercaduca.exceptions.custom.ResourceNotFoundException;
import com.mercaduca.users.entity.User;
import com.mercaduca.users.repository.UserRepository;
import lombok.RequiredArgsConstructor;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.List;
import java.util.stream.Collectors;

@Service
@RequiredArgsConstructor
public class ChatService {

    private final ChatMessageRepository chatMessageRepository;
    private final UserRepository userRepository;

    @Transactional
    public ChatDTOs.MessageResponse sendMessage(ChatDTOs.SendMessageRequest request, Long senderId) {
        User sender = userRepository.findById(senderId)
                .orElseThrow(() -> new ResourceNotFoundException("User", "id", senderId));
        User recipient = userRepository.findById(request.getRecipientId())
                .orElseThrow(() -> new ResourceNotFoundException("User", "id", request.getRecipientId()));

        String conversationId = buildConversationId(senderId, request.getRecipientId());

        ChatMessage msg = ChatMessage.builder()
                .conversationId(conversationId)
                .sender(sender)
                .recipient(recipient)
                .content(request.getContent())
                .productId(request.getProductId())
                .orderId(request.getOrderId())
                .read(false)
                .build();

        chatMessageRepository.save(msg);
        return toResponse(msg);
    }

    @Transactional(readOnly = true)
    public PageResponse<ChatDTOs.MessageResponse> getConversation(String conversationId, Pageable pageable) {
        Page<ChatDTOs.MessageResponse> page = chatMessageRepository
                .findByConversationIdOrderByCreatedAtAsc(conversationId, pageable)
                .map(this::toResponse);
        return PageResponse.from(page);
    }

    @Transactional
    public void markConversationRead(String conversationId, Long userId) {
        chatMessageRepository.markConversationAsRead(conversationId, userId);
    }

    /**
     * Retorna la lista de conversaciones con nombre del otro participante,
     * ultimo mensaje y conteo de no leidos.
     * Cambio respecto a la version anterior (List<String>): ahora devuelve
     * List<ConversationSummary> para que el frontend pueda mostrar nombres
     * en lugar de identificadores numericos.
     */
    @Transactional(readOnly = true)
    public List<ChatDTOs.ConversationSummary> getMyConversations(Long userId) {
        List<ChatMessage> lastMessages =
                chatMessageRepository.findLastMessagesPerConversation(userId);

        return lastMessages.stream().map(msg -> {
            ChatDTOs.ConversationSummary s = new ChatDTOs.ConversationSummary();
            s.setConversationId(msg.getConversationId());

            // Determinar quien es "el otro" en esta conversacion
            boolean iAmSender = msg.getSender().getId().equals(userId);
            User other = iAmSender ? msg.getRecipient() : msg.getSender();

            s.setOtherUserId(other.getId());
            // Mostrar nombre completo; si no tiene, usar username
            String fullName = ((other.getFirstName() != null ? other.getFirstName() : "") +
                               " " +
                               (other.getLastName() != null ? other.getLastName() : "")).trim();
            s.setOtherUserName(fullName.isEmpty() ? other.getUsername() : fullName);

            s.setLastMessage(msg.getContent());
            s.setLastMessageAt(msg.getCreatedAt());
            s.setUnreadCount(
                chatMessageRepository.countUnread(msg.getConversationId(), userId)
            );
            return s;
        }).collect(Collectors.toList());
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    public static String buildConversationId(Long userId1, Long userId2) {
        long a = Math.min(userId1, userId2);
        long b = Math.max(userId1, userId2);
        return "conv_" + a + "_" + b;
    }

    private ChatDTOs.MessageResponse toResponse(ChatMessage msg) {
        ChatDTOs.MessageResponse r = new ChatDTOs.MessageResponse();
        r.setId(msg.getId());
        r.setConversationId(msg.getConversationId());
        r.setSenderId(msg.getSender().getId());
        r.setSenderName(msg.getSender().getFirstName() + " " + msg.getSender().getLastName());
        r.setRecipientId(msg.getRecipient().getId());
        r.setRecipientName(msg.getRecipient().getFirstName() + " " + msg.getRecipient().getLastName());
        r.setOrderId(msg.getOrderId());
        r.setCreatedAt(msg.getCreatedAt());
        return r;
    }
}
